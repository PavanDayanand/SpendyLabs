# The API and production website share this port.
PORT=3001
# Use a persistent disk when deploying. Keep this file private.
WAITLIST_DB_PATH=.data/waitlist.sqlite

# Production waitlist storage. Keep both values server-side in Vercel.
# GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# GOOGLE_SHEETS_WAITLIST_SECRET=replace-with-a-long-random-secret

# Set to 0.0.0.0 only for a host that requires it.
HOST=127.0.0.1
